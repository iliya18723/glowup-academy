NODE_ENV=development
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
TRUST_PROXY=0
MAX_IMAGE_MB=8
MAX_VIDEO_MB=1024

ZARINPAL_CURRENCY=IRT
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=

# Production first-admin bootstrap (required only when running npm run seed in production)
ADMIN_INITIAL_PHONE=
ADMIN_INITIAL_PASSWORD=

# Change an existing admin password with: ADMIN_PHONE=09xxxxxxxxx ADMIN_PASSWORD=... npm run admin:password
