<div class="container page-shell notifications-page">
  <div class="page-heading"><div><span class="eyebrow">NOTIFICATION CENTER</span><h1>اعلان‌های من</h1><p class="muted">خبرهای مهم حساب، پیشرفت دوره‌ها و اتفاق‌های خوبت را اینجا ببین.</p></div><% if (unreadCount) { %><div class="notification-total"><strong><%= unreadCount %></strong><span>خوانده‌نشده</span></div><% } %></div>
  <div class="notification-toolbar"><div class="review-tabs"><a href="/notifications" class="<%= filter==='all'?'active':'' %>">همه <b><%= notifications.length %></b></a><a href="/notifications?filter=unread" class="<%= filter==='unread'?'active':'' %>">خوانده‌نشده <b><%= unreadCount %></b></a></div><% if (unreadCount) { %><form action="/notifications/read-all" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline">✓ علامت‌گذاری همه</button></form><% } %></div>
  <section class="notification-feed">
    <% if (notifications.length) { notifications.forEach(n=>{ %>
      <article class="notification-card <%= n.is_read?'':'unread' %>"><div class="notification-icon"><%= n.type==='certificate'?'🏆':n.type==='referral'?'🎁':n.type==='progress'?'🚀':n.type==='review'?'⭐':'✦' %></div><div class="notification-content"><div class="notification-meta"><span><%= n.type==='certificate'?'گواهینامه':n.type==='referral'?'معرفی و پاداش':n.type==='progress'?'پیشرفت':n.type==='review'?'نظر':'سیستم' %></span><time><%= new Date(n.created_at).toLocaleString('fa-IR') %></time></div><h3><%= n.title %></h3><p><%= n.body || '' %></p><div class="notification-actions"><% if (n.link) { %><a href="<%= n.link %>" class="btn btn-outline">مشاهده</a><% } %><% if (!n.is_read) { %><form action="/notifications/<%= n.id %>/read" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn">✓ خواندم</button></form><% } %></div></div></article>
    <% }) } else { %><div class="empty-state form-card glass"><div class="empty-icon">🔔</div><h2><%= filter==='unread' ? 'همه اعلان‌ها را خوانده‌ای' : 'هنوز اعلانی نداری' %></h2><p class="muted">وقتی اتفاق مهمی در حساب یا دوره‌هایت بیفتد، اینجا نمایش داده می‌شود.</p><a href="/courses" class="btn btn-gold">مشاهده دوره‌ها</a></div><% } %>
  </section>
</div>
