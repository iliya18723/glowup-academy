<%- include('partials/header') %><div class="container" style="padding-top:36px"><span class="eyebrow">PREMIUM PACKS</span><h1>پکیج‌های GlowUp</h1><div class="course-grid"><% bundles.forEach(b=>{ %><article class="course-card glass"><div style="font-size:44px">📦</div><h2><%= b.title %></h2><p><%= b.description||'چند دوره در یک مسیر کامل و اقتصادی.' %></p><div class="price"><%= b.price.toLocaleString('fa-IR') %> تومان</div><form method="POST" action="/cart/bundle/add/<%= b.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-gold full-btn">افزودن پکیج به سبد</button></form><div style="margin-top:14px"><% b.items.forEach(c=>{ %><span class="chip"><%= c.title %></span> <% }) %></div></article><% }) %></div></div><%- include('partials/footer') %>