<%- include('partials/header') %>
<div class="auth-screen">
  <div class="auth-visual">
    <canvas id="particle-canvas"></canvas>
    <div class="av-orb av-orb-1"></div><div class="av-orb av-orb-2"></div>
    <span class="av-badge">✦ آکادمی تخصصی گلو‌آپ</span>
    <h2>دوباره وارد <span class="gold">مسیر تحول</span> شو</h2>
    <p>امن و ساده، رمز حسابت را بازیابی کن و به مسیر یادگیریت برگرد.</p>
    <div class="av-points"><div><span class="av-ico">✓</span> کد بازیابی یک‌بارمصرف</div><div><span class="av-ico">✓</span> اعتبار کد فقط ۱۰ دقیقه</div><div><span class="av-ico">✓</span> تغییر رمز امن</div></div>
  </div>
  <div class="auth-form-side"><div class="auth-box reveal in tilt">
    <div class="logo"><div class="logo-text">GLOW UP<span>ACADEMY</span></div><div class="mark">G</div></div>
    <h2>فراموشی رمز عبور</h2><p class="auth-sub">شماره موبایلت را وارد کن تا کد بازیابی بگیری</p>
    <% if (error) { %><div class="error-box">⚠ <%= error %></div><% } %>
    <% if (success) { %><div class="success-box">✓ <%= success %></div><% } %>
    <% if (devCode) { %><div class="success-box">🔐 کد تست: <strong><%= devCode %></strong><br><a href="/reset-password?phone=<%= encodeURIComponent(phone) %>" class="small-link">ورود کد و تعیین رمز جدید</a></div><% } %>
    <form method="POST" action="/forgot-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field has-icon"><label>شماره موبایل</label><div class="input-icon-group"><input type="text" name="phone" inputmode="numeric" value="<%= phone || '' %>" placeholder="09xxxxxxxxx" required></div></div>
      <button type="submit" class="btn btn-gold">دریافت کد بازیابی</button>
    </form>
    <div class="auth-divider">یا</div><p class="auth-switch"><a href="/login" class="small-link">بازگشت به ورود</a></p>
  </div></div>
</div>
<%- include('partials/footer') %>
