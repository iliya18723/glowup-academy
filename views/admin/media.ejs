<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><span class="eyebrow">MEDIA STUDIO</span><h1>کتابخانه رسانه</h1><div class="sub">همه تصاویر، ویدئوها و فایل‌های محتوایی را یکجا مدیریت کن.</div></div><a href="/" target="_blank" class="btn btn-outline">مشاهده سایت ↗</a></div>
<div class="pro-mini-stats media-stats"><div class="form-card glass"><div><span>کل رسانه‌ها</span><b><%= Number(summary.total||0).toLocaleString('fa-IR') %></b></div><i>◈</i></div><div class="form-card glass"><div><span>تصاویر</span><b><%= Number(summary.images||0).toLocaleString('fa-IR') %></b></div><i>▣</i></div><div class="form-card glass"><div><span>ویدئوها</span><b><%= Number(summary.videos||0).toLocaleString('fa-IR') %></b></div><i>▶</i></div><div class="form-card glass"><div><span>حجم کتابخانه</span><b><%= (Number(summary.bytes||0)/1024/1024/1024).toFixed(2) %> GB</b></div><i>◌</i></div></div>
<div class="admin-grid-2 media-layout">
<section class="form-card glass"><div class="panel-head"><h3>افزودن رسانه</h3><span class="tag">UPLOAD</span></div><form action="/admin/media/upload" method="POST" enctype="multipart/form-data"><%- csrfField %><label class="dropzone"><input type="file" name="file" required><strong>فایل را انتخاب کن</strong><small>تصویر، ویدئو، PDF، صوت و فایل‌های مجاز · حداکثر <%= maxMediaMB %> مگابایت · آپلود مستقیم روی دیسک · مناسب ویدئوهای حجیم</small></label><label>متن جایگزین (Alt)<input name="alt_text" maxlength="200" placeholder="مثلاً: تصویر دوره میکاپ"></label><button class="btn btn-gold full-btn">افزودن به کتابخانه</button></form><div class="builder-hint">✦ برای استفاده در بنر یا سکشن Home، URL رسانه را کپی کن.</div></section>
<section class="form-card glass"><div class="panel-head"><h3>فیلتر و جستجو</h3><span class="tag">SMART FILTER</span></div><form class="pro-filters media-filter" method="GET" action="/admin/media"><input name="q" value="<%= q || '' %>" placeholder="جستجوی نام فایل یا Alt…"><select name="type"><option value="">همه انواع</option><option value="image" <%= type==='image'?'selected':'' %>>تصویر</option><option value="video" <%= type==='video'?'selected':'' %>>ویدئو</option><option value="audio" <%= type==='audio'?'selected':'' %>>صوت</option><option value="pdf" <%= type==='pdf'?'selected':'' %>>PDF</option><option value="other" <%= type==='other'?'selected':'' %>>سایر</option></select><button class="btn btn-outline">اعمال فیلتر</button><a class="small-link" href="/admin/media">پاک کردن</a></form><div class="media-grid">
<% if(!assets.length){ %><div class="empty-state">رسانه‌ای با این فیلتر پیدا نشد.</div><% } %>
<% assets.forEach(a=>{ const mime=String(a.mime_type||''); const isImg=mime.startsWith('image/'); const isVideo=mime.startsWith('video/'); %><article class="media-card"><div class="media-preview"><% if(isImg){ %><img src="<%= a.url %>" alt="<%= a.alt_text || a.filename %>" loading="lazy"><% } else if(isVideo){ %><video src="<%= a.url %>" muted preload="metadata"></video><span>▶</span><% } else { %><div class="file-glyph"><%= mime==='application/pdf'?'PDF':(mime.split('/')[1]||'FILE').toUpperCase().slice(0,5) %></div><% } %></div><div class="media-meta"><strong title="<%= a.filename %>"><%= a.filename %></strong><small><%= mime || 'unknown' %> · <%= (Number(a.size||0)/1024).toFixed(0) %> KB</small><div class="media-actions"><button type="button" class="small-link copy-media" data-url="<%= a.url %>">کپی URL</button><form action="/admin/media/<%= a.id %>/delete" method="POST" onsubmit="return confirm('این رسانه حذف شود؟')"><%- csrfField %><button class="danger-link">حذف</button></form></div></div></article><% }) %></div><% if (totalPages > 1) { %><nav class="media-pagination" aria-label="صفحه‌بندی رسانه"><% if (page > 1) { %><a class="small-link" href="/admin/media?page=<%= page-1 %>&q=<%= encodeURIComponent(q||'') %>&type=<%= encodeURIComponent(type||'') %>">← قبلی</a><% } %><span>صفحه <b><%= page %></b> از <b><%= totalPages %></b></span><% if (page < totalPages) { %><a class="small-link" href="/admin/media?page=<%= page+1 %>&q=<%= encodeURIComponent(q||'') %>&type=<%= encodeURIComponent(type||'') %>">بعدی →</a><% } %></nav><% } %></section></div>
<script>document.querySelectorAll('.copy-media').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.origin+b.dataset.url);b.textContent='کپی شد ✓';setTimeout(()=>b.textContent='کپی URL',1200)}catch(e){prompt('URL رسانه',location.origin+b.dataset.url)}}));</script>
<%- include('../partials/admin-footer') %>