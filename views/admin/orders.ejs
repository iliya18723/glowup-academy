<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><h1>مدیریت سفارش‌ها</h1><div class="sub"><%=orders.length%> نتیجه · تا ۳۰۰ سفارش اخیر</div></div><form class="pro-filters" method="GET" action="/admin/orders"><input name="q" value="<%=q%>" placeholder="نام، موبایل، کد پیگیری یا شماره…"><select name="status"><option value="">همه وضعیت‌ها</option><option value="paid" <%=status==='paid'?'selected':''%>>پرداخت موفق</option><option value="pending" <%=status==='pending'?'selected':''%>>در انتظار</option><option value="failed" <%=status==='failed'?'selected':''%>>ناموفق</option><option value="canceled" <%=status==='canceled'?'selected':''%>>لغوشده</option></select><button class="btn btn-gold">فیلتر</button></form></div>
<div class="pro-mini-stats"><a href="/admin/orders" class="form-card glass"><b><%=Object.values(statusCounts).reduce((a,b)=>a+b,0)%></b><span>کل سفارش‌ها</span></a><a href="/admin/orders?status=paid" class="form-card glass"><b><%=statusCounts.paid||0%></b><span>موفق</span></a><a href="/admin/orders?status=pending" class="form-card glass"><b><%=statusCounts.pending||0%></b><span>در انتظار</span></a><a href="/admin/orders?status=failed" class="form-card glass"><b><%=statusCounts.failed||0%></b><span>ناموفق</span></a></div>
<table class="data-table"><thead><tr><th>#</th><th>کاربر</th><th>مبلغ</th><th>وضعیت</th><th>کد پیگیری</th><th>تاریخ</th><th></th></tr></thead><tbody>
<%orders.forEach(o=>{%><tr><td><a class="small-link" href="/admin/orders/<%=o.id%>">#<%=o.id%></a></td><td><span class="avatar-circle"><%=(o.full_name||'?').charAt(0)%></span><%=o.full_name%><br><small style="color:var(--text-muted);direction:ltr;margin-right:40px"><%=o.phone%></small></td><td><%=o.amount.toLocaleString('fa-IR')%> تومان</td><td><span class="status-pill status-<%=o.status%>"><%=o.status%></span></td><td><%=o.ref_id||'-'%></td><td><%=new Date(o.created_at).toLocaleDateString('fa-IR')%></td><td><a href="/admin/orders/<%=o.id%>" class="small-link">جزئیات</a></td></tr><%})%>
<%if(!orders.length){%><tr><td colspan="7" class="empty-state">سفارشی مطابق فیلترها پیدا نشد.</td></tr><%}%></tbody></table>
<%- include('../partials/admin-footer') %>
