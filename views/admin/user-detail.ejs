<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><h1><%= user.full_name %></h1><div class="sub"><%= user.phone %> · عضو از <%= new Date(user.created_at).toLocaleDateString('fa-IR') %></div></div><a class="btn btn-outline" href="/admin/users">← کاربران</a></div>
<div class="admin-grid-2"><section class="form-card glass"><h3>اطلاعات حساب</h3><p>ایمیل: <%= user.email || 'ثبت نشده' %></p><p>نقش: <strong><%= user.role %></strong></p><p>تعداد سفارش: <strong><%= orders.length %></strong></p></section><section class="form-card glass"><h3>دوره‌های خریداری‌شده</h3><% courses.forEach(c=>{const pct=c.total_sessions?Math.round(c.completed_sessions/c.total_sessions*100):0;%><div class="rank-row"><span><%= c.title %></span><strong><%= pct %>٪</strong></div><%})%><%if(!courses.length){%><p class="muted">دوره‌ای خریداری نشده.</p><%}%></section></div>
<h3>سفارش‌ها</h3><table class="data-table"><thead><tr><th>#</th><th>مبلغ</th><th>وضعیت</th><th>تاریخ</th></tr></thead><tbody><%orders.forEach(o=>{%><tr><td>#<%=o.id%></td><td><%=o.amount.toLocaleString('fa-IR')%> تومان</td><td><span class="status-pill status-<%=o.status%>"><%=o.status%></span></td><td><%=new Date(o.created_at).toLocaleDateString('fa-IR')%></td></tr><%})%></tbody></table>
<%- include('../partials/admin-footer') %>
