<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><h1>مدیریت نظرات</h1><div class="sub">نظرات کاربران را قبل از انتشار کنترل کن.</div></div></div>
<div class="review-tabs"><a class="<%= status==='all'?'active':'' %>" href="/admin/reviews">همه <b><%= counts.all %></b></a><a class="<%= status==='pending'?'active':'' %>" href="/admin/reviews?status=pending">در انتظار <b><%= counts.pending %></b></a><a class="<%= status==='approved'?'active':'' %>" href="/admin/reviews?status=approved">تأییدشده <b><%= counts.approved %></b></a></div>
<div class="admin-review-list"><% reviews.forEach(r=>{ %><article class="form-card glass admin-review"><div class="review-top"><div><strong><%= r.full_name %></strong><small><%= r.course_title %> · <%= new Date(r.created_at).toLocaleDateString('fa-IR') %></small></div><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div></div><p><%= r.body || 'بدون متن' %></p><div class="row-actions"><% if(!r.is_approved){ %><form action="/admin/reviews/<%= r.id %>/approve" method="POST"><%- csrfField %><button class="btn btn-gold">تأیید و انتشار</button></form><% } else { %><form action="/admin/reviews/<%= r.id %>/reject" method="POST"><%- csrfField %><button class="btn btn-outline">برداشتن انتشار</button></form><% } %><form action="/admin/reviews/<%= r.id %>/delete" method="POST" onsubmit="return confirm('این نظر حذف شود؟')"><%- csrfField %><button class="btn btn-danger">حذف</button></form></div></article><% }) %><% if(!reviews.length){ %><div class="empty-state glass"><h3>نظری نیست</h3><p>فعلاً چیزی برای بررسی وجود ندارد.</p></div><% } %></div>
<%- include('../partials/admin-footer') %>
