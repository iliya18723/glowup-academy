<%- include('../partials/admin-header') %>
<div class="admin-topbar">
  <div><h1>مدیریت کاربران</h1><div class="sub"><%= users.length %> نتیجه · تا ۳۰۰ کاربر اخیر</div></div>
  <form class="pro-filters" method="GET" action="/admin/users"><input name="q" value="<%= q %>" placeholder="نام، موبایل یا ایمیل…"><select name="role"><option value="">همه نقش‌ها</option><option value="user" <%=role==='user'?'selected':''%>>کاربر</option><option value="admin" <%=role==='admin'?'selected':''%>>Super Admin</option><option value="editor" <%=role==='editor'?'selected':''%>>Editor</option><option value="support" <%=role==='support'?'selected':''%>>Support</option></select><button class="btn btn-gold">فیلتر</button></form>
</div>
<div class="pro-mini-stats"><a href="/admin/users" class="form-card glass"><b><%= Object.values(roleCounts).reduce((a,b)=>a+b,0) %></b><span>کل کاربران</span></a><a href="/admin/users?role=user" class="form-card glass"><b><%= roleCounts.user||0 %></b><span>کاربر عادی</span></a><a href="/admin/users?role=editor" class="form-card glass"><b><%= roleCounts.editor||0 %></b><span>Editor</span></a><a href="/admin/users?role=support" class="form-card glass"><b><%= roleCounts.support||0 %></b><span>Support</span></a></div>
<table class="data-table"><thead><tr><th>کاربر</th><th>موبایل</th><th>نقش</th><th>عضویت</th><th>عملیات</th></tr></thead><tbody>
<% users.forEach(u=>{ %><tr><td><span class="avatar-circle"><%= (u.full_name||'?').charAt(0) %></span><a href="/admin/users/<%=u.id%>"><%=u.full_name%></a></td><td style="direction:ltr;text-align:left"><%=u.phone%></td><td><form action="/admin/users/<%=u.id%>/role" method="POST" style="display:flex;gap:6px"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="role" onchange="this.form.submit()"><option value="user" <%=u.role==='user'?'selected':''%>>کاربر عادی</option><option value="admin" <%=u.role==='admin'?'selected':''%>>Super Admin</option><option value="editor" <%=u.role==='editor'?'selected':''%>>Editor</option><option value="support" <%=u.role==='support'?'selected':''%>>Support</option></select></form></td><td><%=new Date(u.created_at).toLocaleDateString('fa-IR')%></td><td><a class="small-link" href="/admin/users/<%=u.id%>">پروفایل ←</a></td></tr><% }) %>
<%if(!users.length){%><tr><td colspan="5" class="empty-state">کاربری مطابق فیلترها پیدا نشد.</td></tr><%}%></tbody></table>
<%- include('../partials/admin-footer') %>
