<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><span class="eyebrow">NAVIGATION</span><h1>منوی سایت</h1><div class="sub">لینک‌های Header را مستقیم از پنل مدیریت کن.</div></div></div>
<div class="admin-grid-2"><section class="form-card glass"><div class="panel-head"><h3>افزودن آیتم</h3></div><form action="/admin/menu/new" method="POST">
    <%- csrfField %>
<div class="form-row"><label>عنوان<input name="label" required></label><label>لینک<input name="url" placeholder="/courses" dir="ltr" required></label></div><div class="form-row"><label>موقعیت<select name="location"><option value="header">Header</option></select></label><label>ترتیب<input type="number" name="sort_order" value="0"></label></div><label class="switch-row"><input type="checkbox" name="is_published" checked> نمایش</label><button class="btn btn-gold">افزودن</button></form></section><section class="form-card glass"><div class="panel-head"><h3>آیتم‌های منو</h3></div><div class="sortable-list" id="menuList"><% items.forEach(i=>{ %><article class="cms-row sortable-item" draggable="true" data-id="<%= i.id %>"><div><b><%= i.label %></b><small dir="ltr"><%= i.url %></small></div><div class="row-actions"><span class="status-pill <%= i.is_published?'status-paid':'status-pending' %>"><%= i.is_published?'فعال':'خاموش' %></span><form action="/admin/menu/<%= i.id %>/toggle" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-link"><%= i.is_published?'مخفی':'نمایش' %></button></form><form action="/admin/menu/<%= i.id %>/delete" method="POST" onsubmit="return confirm('حذف شود؟')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-link">حذف</button></form></div></article><% }) %></div></section></div>
<script>const list=document.getElementById('menuList');let drag=null;list?.querySelectorAll('.sortable-item').forEach(row=>{row.addEventListener('dragstart',()=>drag=row);row.addEventListener('dragover',e=>{e.preventDefault();if(drag&&drag!==row){const r=row.getBoundingClientRect();list.insertBefore(drag,e.clientY<r.top+r.height/2?row:row.nextSibling)}});row.addEventListener('dragend',()=>fetch('/admin/menu/reorder',{method:'POST',headers:{'Content-Type':'application/json','x-csrf-token':'<%= csrfToken %>'},body:JSON.stringify({ids:[...list.children].map(x=>x.dataset.id)})}).then(r=>{if(!r.ok)throw new Error('save');return r.json()}).catch(()=>location.reload()))});</script>
<%- include('../partials/admin-footer') %>
