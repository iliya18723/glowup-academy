<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><span class="eyebrow">SYSTEM</span><h1>وضعیت سیستم</h1><div class="sub">سلامت سریع دیتابیس و Runtime.</div></div><span class="live-status"><i></i> Online</span></div>
<div class="stat-grid"><div class="stat-card"><div class="stat-icon">⚙</div><div class="num"><%= uptime %>s</div><div class="label">Uptime</div></div><div class="stat-card"><div class="stat-icon">◉</div><div class="num"><%= (dbSize/1024/1024).toFixed(2) %>MB</div><div class="label">حجم دیتابیس</div></div><div class="stat-card"><div class="stat-icon">JS</div><div class="num" style="font-size:18px"><%= node %></div><div class="label">Node.js</div></div><div class="stat-card"><div class="stat-icon">▦</div><div class="num"><%= tables.length %></div><div class="label">جدول دیتابیس</div></div></div>
<section class="form-card glass"><div class="panel-head"><h3>جدول‌های فعال</h3><span class="tag">SQLite</span></div><div class="system-table"><% tables.forEach(t=>{ %><span class="system-chip"><%= t.name %></span><% }) %></div></section>
<section class="form-card glass" data-admin-live><div class="panel-head"><h3>مانیتور زنده</h3><span class="live-status"><i></i> هر ۱۵ ثانیه</span></div><div class="live-metrics"><div><small>درآمد کل</small><strong data-live="revenue">—</strong></div><div><small>درآمد امروز</small><strong data-live="todayRevenue">—</strong></div><div><small>سفارش امروز</small><strong data-live="todayOrders">—</strong></div><div><small>کاربران ۲۴ ساعت</small><strong data-live="activeUsers">—</strong></div><div><small>در انتظار</small><strong data-live="pending">—</strong></div><div><small>Uptime</small><strong data-live-uptime>—</strong></div></div></section>
<%- include('../partials/admin-footer') %>
