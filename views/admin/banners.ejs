<%- include('../partials/admin-header') %>
<div class="admin-topbar"><div><span class="eyebrow">HOME / CAMPAIGNS</span><h1>مدیریت بنرها</h1><div class="sub">بنرهای سینمایی Home را بدون تغییر کد کنترل کن.</div></div><a href="/" target="_blank" class="btn btn-outline">پیش‌نمایش ↗</a></div>
<div class="admin-grid-2">
<section class="form-card glass"><div class="panel-head"><h3>بنر جدید</h3><span class="tag">LIVE CMS</span></div><form action="/admin/banners/new" method="POST">
    <%- csrfField %>
<div class="field"><label>Eyebrow</label><input name="eyebrow" placeholder="LIMITED / SPECIAL"></div><div class="field"><label>عنوان</label><input name="title" required placeholder="مسیر جدیدت از همین امروز شروع می‌شود"></div><div class="field"><label>توضیح</label><textarea name="subtitle" rows="4"></textarea></div><div class="form-row"><label>متن دکمه<input name="cta_text" value="مشاهده دوره‌ها"></label><label>لینک<input name="cta_url" value="/courses" dir="ltr"></label></div><div class="form-row"><label>تصویر<input name="image" placeholder="/uploads/banner.jpg" dir="ltr"></label><label>ترتیب<input type="number" name="sort_order" value="0"></label></div><div class="form-row"><label>شروع<input type="datetime-local" name="starts_at"></label><label>پایان<input type="datetime-local" name="ends_at"></label></div><label class="switch-row"><input type="checkbox" name="is_published" checked> منتشر شود</label><button class="btn btn-gold">ساخت بنر</button></form></section>
<section class="form-card glass"><div class="panel-head"><h3>بنرهای فعلی</h3><span class="tag"><%= banners.length %> مورد</span></div><div class="sortable-list" id="bannerList"><% banners.forEach(b=>{ %><article class="cms-row sortable-item" draggable="true" data-id="<%= b.id %>"><div><b><%= b.title %></b><small><%= b.eyebrow || 'بدون eyebrow' %> · ترتیب <%= b.sort_order %></small></div><div class="row-actions"><span class="status-pill <%= b.is_published?'status-paid':'status-pending' %>"><%= b.is_published?'فعال':'خاموش' %></span><form action="/admin/banners/<%= b.id %>/toggle" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-link"><%= b.is_published?'مخفی':'نمایش' %></button></form><form action="/admin/banners/<%= b.id %>/delete" method="POST" onsubmit="return confirm('بنر حذف شود؟')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-link">حذف</button></form></div></article><% }) %></div><p class="builder-hint">✦ ردیف‌ها را بکش و برای مرتب‌سازی رها کن.</p></section></div>
<script>document.querySelectorAll('.sortable-list').forEach(list=>{let drag=null;list.querySelectorAll('.sortable-item').forEach(row=>{row.addEventListener('dragstart',()=>drag=row);row.addEventListener('dragover',e=>{e.preventDefault();if(drag&&drag!==row){const r=row.getBoundingClientRect();list.insertBefore(drag,e.clientY<r.top+r.height/2?row:row.nextSibling)}});row.addEventListener('dragend',()=>{fetch('/admin/banners/reorder',{method:'POST',headers:{'Content-Type':'application/json','x-csrf-token':'<%= csrfToken %>'},body:JSON.stringify({ids:[...list.children].map(x=>x.dataset.id)})}).then(r=>{if(!r.ok)throw new Error('save');return r.json()}).catch(()=>location.reload())})})});</script>
<%- include('../partials/admin-footer') %>
