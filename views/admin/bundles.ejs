<%- include('../partials/admin-header') %><div class="admin-topbar"><div><h1>پکیج‌های فروش</h1><div class="sub">چند دوره را در یک پیشنهاد ویژه بفروش.</div></div></div><section class="form-card glass"><form method="POST" action="/admin/bundles/new" class="admin-form-grid">
    <%- csrfField %>
<label>عنوان<input name="title" required></label><label>قیمت پکیج<input name="price" type="number" required></label><label style="grid-column:1/-1">توضیح<textarea name="description"></textarea></label><label style="grid-column:1/-1">دوره‌ها<select name="course_ids" multiple size="6"><% courses.forEach(c=>{ %><option value="<%= c.id %>"><%= c.title %> — <%= (c.discount_price||c.price).toLocaleString('fa-IR') %></option><% }) %></select></label><label><input type="checkbox" name="is_published" checked> منتشر شود</label><button class="btn btn-gold">ساخت پکیج</button></form></section><table class="data-table"><thead><tr><th>پکیج</th><th>دوره‌ها</th><th>قیمت</th><th></th></tr></thead><tbody><% bundles.forEach(b=>{ %><tr><td><strong><%= b.title %></strong></td><td><%= b.course_count %></td><td><%= b.price.toLocaleString('fa-IR') %></td><td><form method="POST" action="/admin/bundles/<%= b.id %>/delete" onsubmit="return confirm('این پکیج حذف شود؟')">
  <%- csrfField %><button class="btn btn-danger">حذف</button></form></td></tr><% }) %></tbody></table><%- include('../partials/admin-footer') %>