<%- include('../partials/admin-header') %><div class="admin-topbar"><div><h1>معرفی دوستان</h1><div class="sub">عملکرد کدهای دعوت کاربران.</div></div></div><table class="data-table"><thead><tr><th>کاربر</th><th>کد</th><th>معرفی‌ها</th><th>موفق</th><th>پاداش ثبت‌شده</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.full_name %><br><small><%= r.phone %></small></td><td><strong class="code-chip"><%= r.code %></strong></td><td><%= r.referred %></td><td><%= r.rewarded %></td><td><%= Number(r.reward_total||0).toLocaleString('fa-IR') %> تومان</td></tr><% }) %></tbody></table><%- include('../partials/admin-footer') %>